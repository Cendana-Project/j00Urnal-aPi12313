env: "development" # staging / production
log_level: "info" # warm
graceful_shutdown_timeout: "30s"
token:
  password_salt: "b5zaUPemaUN3YVPQ" # random 16 char
  access_token_secret: "17A9Y63VUmMotuuS" # random char
  access_token_duration: "8h"
  refresh_token_secret: "17A9YPemaUN3YVPQ" # random char
  refresh_token_duration: "168h"
server:
  port: 8080
  base_url: "http://localhost:8080"
database:
  dsn: "postgres://user:password@localhost:5432/api_monolith?sslmode=disable"
  ping_interval: "30s"
  reconnect_factor: 2
  min_jitter: "200ms"
  max_jitter: "500ms"
  max_retry: 5
  max_idle_conns: 5
  max_open_conns: 20
  max_conn_life_time: "1h"
redis:
  is_cache_disable: "false"
  cache_dsn: "redis://user:password@localhost:6379/0?protocol=3"
  default_cache_duration: "15m"
  max_retry: 5
  max_idle_conns: 5
  max_active_conns: 20
  max_conn_life_time: "1h"
smtp:
  host: "smtp.gmail.com"
  port: 587
  username: "your-email@gmail.com"
  password: "your-app-password"
  from: "Your Name <your-email@gmail.com>"
stripe:
  secret_key: "sk_test_your_stripe_secret_key"
  publishable_key: "pk_test_your_stripe_publishable_key"
  webhook_secret: "whsec_your_webhook_secret"
  default_currency: "USD"
  supported_currencies: ["USD", "EUR", "GBP", "SGD", "MYR", "IDR"]
  min_amounts:
    USD: 0.50
    EUR: 0.50
    GBP: 0.30
    SGD: 0.50
    MYR: 1.00
    IDR: 1000.00
  max_amounts:
    USD: 10000.00
    EUR: 10000.00
    GBP: 10000.00
    SGD: 10000.00
    MYR: 10000.00
    IDR: 100000000.00
  max_retries: 3
  retry_delay: "1s"
aws:
  region:     "ap-southeast-2"
  s3_bucket:  "s.....-....s"
