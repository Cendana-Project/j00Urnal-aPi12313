# Environment Variables untuk Production
# Copy file ini ke .env dan isi dengan nilai yang sesuai

# Application Environment
ENV=production
LOG_LEVEL=info
GRACEFUL_SHUTDOWN_TIMEOUT=30s

# Server Configuration
SERVER_PORT=8081
SERVER_BASE_URL=https://your-app-name.railway.app

# Database Configuration (PostgreSQL)
DATABASE_DSN=postgresql://username:password@host:port/database?sslmode=require

# Redis Configuration
REDIS_CACHE_DSN=redis://username:password@host:port/database
REDIS_IS_CACHE_DISABLE=false
REDIS_DEFAULT_CACHE_DURATION=15m
REDIS_MAX_RETRY=5
REDIS_MAX_IDLE_CONNS=5
REDIS_MAX_ACTIVE_CONNS=20
REDIS_MAX_CONN_LIFE_TIME=1h

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Token Configuration
TOKEN_PASSWORD_SALT=your-password-salt-here
TOKEN_ACCESS_TOKEN_SECRET=your-access-token-secret
TOKEN_ACCESS_TOKEN_DURATION=1h
TOKEN_REFRESH_TOKEN_SECRET=your-refresh-token-secret
TOKEN_REFRESH_TOKEN_DURATION=30h
TOKEN_FORGOT_PASSWORD_RATE_LIMIT=3
TOKEN_FORGOT_PASSWORD_RATE_WINDOW=1h

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Database Connection Pool
DB_PING_INTERVAL=10s
DB_RECONNECT_FACTOR=2
DB_MIN_JITTER=200ms
DB_MAX_JITTER=500ms
DB_MAX_RETRY=5
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=30
DB_MAX_CONN_LIFE_TIME=30m
