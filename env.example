# ==========================================
# JOURNAL API - Environment Configuration
# ==========================================
# Copy this file to .env and update with your values
# For development: cp env.example .env.local
# For production: Set these in your deployment platform
#
# Generate secure secrets:
#   openssl rand -base64 32
# ==========================================

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
# Environment: development, staging, production
ENV=development

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Graceful shutdown timeout
GRACEFUL_SHUTDOWN_TIMEOUT=30s

# ==========================================
# SERVER CONFIGURATION
# ==========================================
# Server port (default: 8080)
SERVER_PORT=8080

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
# Required: PostgreSQL connection string
# Format: postgres://user:password@host:port/database?sslmode=disable
# Example: postgres://postgres:postgres@localhost:5432/journal_api?sslmode=disable
DATABASE_DSN=postgres://postgres:postgres@localhost:5432/journal_api?sslmode=disable

# Database connection pool settings (optional - defaults provided)
DATABASE_PING_INTERVAL=30s
DATABASE_RECONNECT_FACTOR=2
DATABASE_MIN_JITTER=200ms
DATABASE_MAX_JITTER=500ms
DATABASE_MAX_RETRY=5
DATABASE_MAX_IDLE_CONNS=10
DATABASE_MAX_OPEN_CONNS=30
DATABASE_MAX_CONN_LIFETIME=1h

# ==========================================
# REDIS CONFIGURATION
# ==========================================
# Required if cache is enabled: Redis connection string
# Format: redis://[user:password@]host:port/database
# Example: redis://localhost:6379/0

UPSTASH_REDIS_REST_URL=minta-sama-radit
UPSTASH_REDIS_REST_TOKEN="minta-sama-radit"

# Disable cache (set to true to disable Redis caching)
REDIS_IS_CACHE_DISABLE=false

# Default cache duration (optional - defaults provided)
REDIS_DEFAULT_CACHE_DURATION=15m
REDIS_MAX_RETRY=5
REDIS_MAX_IDLE_CONNS=5
REDIS_MAX_ACTIVE_CONNS=20
REDIS_MAX_CONN_LIFETIME=1h

# ==========================================
# JWT TOKEN CONFIGURATION (SECURITY CRITICAL!)
# ==========================================
# IMPORTANT: Change all secrets to random strings in production!
# Generate secure random strings:
#   openssl rand -base64 32
#   or: head -c 32 /dev/urandom | base64

# Required: Password salt (minimum 16 characters)
TOKEN_PASSWORD_SALT=UA4uEMDEuIFkKz/go/JSWVPsD1vOqokZjIKGGUBJyiw=

# Required: Access token secret (minimum 16 characters)
TOKEN_ACCESS_TOKEN_SECRET=MMqHFwxpEiTc0EXTLENFZJuQcla91cswZfW7OE8taJ0=

# Access token duration (optional - default: 1h)
# Examples: 15m, 1h, 24h
TOKEN_ACCESS_TOKEN_DURATION=1h

# Required: Refresh token secret (minimum 16 characters)
TOKEN_REFRESH_TOKEN_SECRET=/60WdLHQ5Aoi1Q5Eb+0ru1eCYcrPYZb3lSTelIT38P0=

# Refresh token duration (optional - default: 720h = 30 days)
# Examples: 24h, 168h, 720h
TOKEN_REFRESH_TOKEN_DURATION=720h

# ==========================================
# PRODUCTION EXAMPLE
# ==========================================
# For production deployment, use strong random secrets:
#
# ENV=production
# LOG_LEVEL=info
# SERVER_PORT=8080
# DATABASE_DSN=postgres://user:STRONG_PASSWORD@db-host:5432/prod_db?sslmode=require
# REDIS_CACHE_DSN=redis://:REDIS_PASSWORD@redis-host:6379/0
# TOKEN_PASSWORD_SALT=$(openssl rand -base64 32)
# TOKEN_ACCESS_TOKEN_SECRET=$(openssl rand -base64 32)
# TOKEN_REFRESH_TOKEN_SECRET=$(openssl rand -base64 32)
# ==========================================
