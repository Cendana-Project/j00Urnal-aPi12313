# ==========================================
# JOURNAL API - Environment Configuration
# ==========================================
# Copy this file to .env and update with your values
# For development: cp env.example .env
# For production: Set these in your deployment platform
#
# Generate secure secrets:
#   openssl rand -base64 32
# ==========================================

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
# Environment: development, staging, production
ENV=development

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Graceful shutdown timeout
GRACEFUL_SHUTDOWN_TIMEOUT=30s

# ==========================================
# SERVER CONFIGURATION
# ==========================================
# Server port (default: 8080)
SERVER_PORT=8080

# Public backend URL. Used as a fallback when building links.
SERVER_BASE_URL=http://localhost:8080

# Frontend origin used for CORS and links in reviewer invitation emails.
# Multiple CORS origins may be comma-separated; the first is used for email links.
SERVER_FRONTEND_URL=http://localhost:3000

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
# Required: PostgreSQL connection string
# Format: postgres://user:password@host:port/database?sslmode=disable
# For Supabase: Use connection pooler URL (port 6543 with pgbouncer=true)
# DATABASE_DSN=postgresql://postgres.xxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# For local development:
DATABASE_DSN=postgres://postgres:postgres@localhost:5432/journal_api?sslmode=disable

# Direct database connection (bypasses PgBouncer) - REQUIRED for migrations
# For Supabase: Use direct URL (port 5432)
# DATABASE_DIRECT_DSN=postgresql://postgres.xxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
#
# For local: leave empty (will use DATABASE_DSN)
# DATABASE_DIRECT_DSN=

# Database connection pool settings (optional - defaults provided)
# These defaults are optimized for production workload
DATABASE_PING_INTERVAL=30s
DATABASE_RECONNECT_FACTOR=2
DATABASE_MIN_JITTER=200ms
DATABASE_MAX_JITTER=500ms
DATABASE_MAX_RETRY=5

# Connection pool settings (optional - defaults: idle=5, open=20, lifetime=30m)
# For Supabase/PgBouncer: Keep these LOW since PgBouncer handles pooling
# Supabase free tier limit: ~20 connections
DATABASE_MAX_IDLE_CONNS=5
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_CONN_LIFETIME=30m

# ==========================================
# SUPABASE API CONFIGURATION
# ==========================================
# Required by file storage and by the supabase_rest health/keep-alive probe.
# Find these values in Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional unless a client-side/public flow explicitly uses it.
SUPABASE_ANON_ROLE_KEY=your-anon-key
SUPABASE_BUCKET=publication

# ==========================================
# REDIS CONFIGURATION
# ==========================================
# Required if cache is enabled: Redis connection string
# Format: redis://[user:password@]host:port/database
# Local Redis (Redis is also used for refresh-token and PIN state):
REDIS_CACHE_DSN=redis://localhost:6379/0

# Disable only when intentionally running without Redis-backed auth state.
REDIS_IS_CACHE_DISABLE=false

# Default cache duration (optional - defaults provided)
REDIS_DEFAULT_CACHE_DURATION=15m
REDIS_MAX_RETRY=5
REDIS_MAX_IDLE_CONNS=5
REDIS_MAX_ACTIVE_CONNS=20
REDIS_MAX_CONN_LIFETIME=1h

# ==========================================
# JWT TOKEN CONFIGURATION (SECURITY CRITICAL!)
# ==========================================
# IMPORTANT: Change all secrets to random strings in production!
# Generate secure random strings:
#   openssl rand -base64 32
#   or: head -c 32 /dev/urandom | base64

# Required: Password salt (minimum 16 characters)
TOKEN_PASSWORD_SALT=UA4uEMDEuIFkKz/go/JSWVPsD1vOqokZjIKGGUBJyiw=

# Required: Access token secret (minimum 16 characters)
TOKEN_ACCESS_TOKEN_SECRET=MMqHFwxpEiTc0EXTLENFZJuQcla91cswZfW7OE8taJ0=

# Access token duration (optional - default: 1h)
# Examples: 15m, 1h, 24h
TOKEN_ACCESS_TOKEN_DURATION=1h

# Required: Refresh token secret (minimum 16 characters)
TOKEN_REFRESH_TOKEN_SECRET=/60WdLHQ5Aoi1Q5Eb+0ru1eCYcrPYZb3lSTelIT38P0=

# Refresh token duration (optional - default: 720h = 30 days)
# Examples: 24h, 168h, 720h
TOKEN_REFRESH_TOKEN_DURATION=720h

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Email provider selection
# Options: "brevo-api" (recommended for cloud), "smtp" (traditional)
# Brevo API uses HTTPS (port 443) - never blocked by cloud providers
# SMTP uses ports 587/465 - often blocked in cloud environments
EMAIL_PROVIDER=brevo-api

# ==========================================
# BREVO HTTP API (RECOMMENDED)
# ==========================================
# Use Brevo HTTP API to avoid SMTP port blocking in cloud environments
# Free tier: 300 emails/day (perfect for development & testing)
# Get API key (v3) from: https://app.brevo.com/settings/keys/api
# This is the RECOMMENDED method for Render, Railway, Heroku, etc.
# IMPORTANT: Use the v3 API key, NOT the SMTP key!
SMTP_PASSWORD=your-brevo-api-key-v3-here
SMTP_FROM_EMAIL=noreply@medikaone.com

# Note: When using brevo-api, SMTP_HOST, SMTP_PORT, and SMTP_USERNAME are ignored
# The API uses HTTPS (port 443) automatically

# ==========================================
# OR USE BREVO SMTP (Alternative - may be blocked)
# ==========================================
# Brevo SMTP uses traditional email ports (may be blocked in cloud)
# Free tier: 300 emails/day
# Get SMTP key from: https://app.brevo.com/settings/keys/smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-login@smtp-brevo.com
# SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_FROM_EMAIL=noreply@medikaone.com
# EMAIL_PROVIDER=smtp

# ==========================================
# OR USE TRADITIONAL SMTP (May be blocked)
# ==========================================
# Traditional SMTP (ports 587/465 often blocked in cloud)
# For Hostinger:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@yourdomain.com
# SMTP_PASSWORD=your_hostinger_password
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# EMAIL_PROVIDER=smtp

# For Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# EMAIL_PROVIDER=smtp

# Email settings
# Disable email completely (users will be auto-activated)
EMAIL_ENABLED=true

# Email timeout in seconds (optional, default: 10)
EMAIL_TIMEOUT_SECONDS=10

# ==========================================
# HOSTINGER EMAIL CONFIGURATION EXAMPLE
# ==========================================
# If you're using Hostinger email, use these settings:
#
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@yourdomain.com
# SMTP_PASSWORD=your_hostinger_email_password
# SMTP_FROM_EMAIL=noreply@yourdomain.com
#
# Note: Port 587 uses STARTTLS, Port 465 uses SSL
# Make sure your email account is created in Hostinger hPanel first

# ==========================================
# PRODUCTION EXAMPLE
# ==========================================
# For production deployment, use strong random secrets:
#
# ENV=production
# LOG_LEVEL=info
# SERVER_PORT=8080
# SERVER_BASE_URL=https://api.example.com
# SERVER_FRONTEND_URL=https://journal.example.com
# DATABASE_DSN=postgres://user:STRONG_PASSWORD@db-host:5432/prod_db?sslmode=require
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# REDIS_CACHE_DSN=redis://:REDIS_PASSWORD@redis-host:6379/0
# TOKEN_PASSWORD_SALT=$(openssl rand -base64 32)
# TOKEN_ACCESS_TOKEN_SECRET=$(openssl rand -base64 32)
# TOKEN_REFRESH_TOKEN_SECRET=$(openssl rand -base64 32)
# ==========================================
